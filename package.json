{
  "name": "multi-institution-internship-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Institution Internship Management Platform (Full-Stack)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "npm --prefix server start",
    "dev": "npm --prefix client run dev",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "server:test-db": "npm --prefix server run test:db",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm run vercel-build",
    "vercel-build": "npm run --workspaces --if-present vercel-build"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.1",
    "prisma": "^5.22.0"
  }
}
