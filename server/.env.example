# ==============================================================
# Multi-Institution Internship Management Platform - Config Example
# ==============================================================
# Copy this file to .env and replace placeholders with your credentials.
# NEVER commit your actual .env file with live secrets to GitHub!

# Server Configuration
PORT=5001
NODE_ENV=production

# Database Connection (PostgreSQL / Neon Cloud)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
DATABASE_URL="postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name?sslmode=require"

# Authentication Secrets (JWT)
# Use a strong, random 32+ character secret string in production
JWT_SECRET="your_secure_random_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Client URL (Allowed CORS origin in production)
CLIENT_URL="http://localhost:5173"
