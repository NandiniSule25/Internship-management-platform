# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=prefer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/internship_platform?schema=public"

# Authentication Secrets (Used in Phase 2)
JWT_SECRET="super-secret-jwt-key-replace-in-production-min32chars"
JWT_EXPIRES_IN="7d"

# Client URL (CORS origin)
CLIENT_URL="http://localhost:5173"
