generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------
enum Role {
  INSTITUTION_ADMIN
  MENTOR
  INTERN
}

enum InternshipStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
}

enum ReportType {
  INTERN_PERFORMANCE
  INSTITUTION_SUMMARY
  TASK_AUDIT
}

// -------------------------------------------------------------
// INSTITUTION MODEL
// -------------------------------------------------------------
model Institution {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique // Short code or acronym e.g., "IITB", "MIT"
  contactEmail String
  phone        String?
  address      String?
  website      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  users        User[]
  internships  Internship[]
  reports      ReportAudit[]

  @@map("institutions")
}

// -------------------------------------------------------------
// USER MODEL (Supports Institution Admin, Mentor, Intern)
// -------------------------------------------------------------
model User {
  id            String       @id @default(uuid())
  email         String       @unique
  password      String       // Hashed with bcrypt
  firstName     String
  lastName      String
  role          Role         @default(INTERN)
  phone         String?
  avatar        String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  // Mentorship relations
  mentoredInternships Internship[] @relation("MentorInternships")
  internships         Internship[] @relation("InternInternships")

  // Tasks relations
  createdTasks        Task[]       @relation("TaskCreator")
  assignedTasks       Task[]       @relation("TaskAssignee")

  // Progress updates & evaluations
  progressUpdates     ProgressUpdate[]
  evaluationsGiven    Evaluation[] @relation("EvaluationsGiven")
  evaluationsReceived Evaluation[] @relation("EvaluationsReceived")
  reportsGenerated    ReportAudit[]

  @@index([institutionId])
  @@index([role])
  @@map("users")
}

// -------------------------------------------------------------
// INTERNSHIP MODEL
// -------------------------------------------------------------
model Internship {
  id            String           @id @default(uuid())
  title         String
  description   String
  department    String
  startDate     DateTime
  endDate       DateTime
  status        InternshipStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  mentorId      String?
  mentor        User?            @relation("MentorInternships", fields: [mentorId], references: [id], onDelete: SetNull)

  internId      String?
  intern        User?            @relation("InternInternships", fields: [internId], references: [id], onDelete: SetNull)

  tasks         Task[]
  evaluations   Evaluation[]

  @@index([institutionId])
  @@index([mentorId])
  @@index([internId])
  @@map("internships")
}

// -------------------------------------------------------------
// TASK MODEL (Allocated by Mentor/Admin with Deadlines)
// -------------------------------------------------------------
model Task {
  id              String         @id @default(uuid())
  title           String
  description     String?
  priority        TaskPriority   @default(MEDIUM)
  status          TaskStatus     @default(TODO)
  deadline        DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  internshipId    String
  internship      Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  creatorId       String
  creator         User           @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  assigneeId      String
  assignee        User           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  progressUpdates ProgressUpdate[]

  @@index([internshipId])
  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
}

// -------------------------------------------------------------
// PROGRESS UPDATE MODEL (Submitted by Interns)
// -------------------------------------------------------------
model ProgressUpdate {
  id             String      @id @default(uuid())
  updateNote     String
  workUrl        String?     // Link to github PR, doc, deployment, etc.
  hoursSpent     Float?
  statusAtUpdate TaskStatus  @default(IN_PROGRESS)
  createdAt      DateTime    @default(now())

  taskId         String
  task           Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  internId       String
  intern         User        @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([internId])
  @@map("progress_updates")
}

// -------------------------------------------------------------
// EVALUATION MODEL (Submitted by Mentors for Interns)
// -------------------------------------------------------------
model Evaluation {
  id                 String      @id @default(uuid())
  technicalScore     Int         // Scale 1-10
  communicationScore Int         // Scale 1-10
  punctualityScore   Int         // Scale 1-10
  overallScore       Float       // Calculated average / 10
  feedback           String
  recommendation     String?     // Hire recommendation / remarks
  evaluatedAt        DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  internshipId       String
  internship         Internship  @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  mentorId           String
  mentor             User        @relation("EvaluationsGiven", fields: [mentorId], references: [id], onDelete: Cascade)

  internId           String
  intern             User        @relation("EvaluationsReceived", fields: [internId], references: [id], onDelete: Cascade)

  @@index([internshipId])
  @@index([internId])
  @@map("evaluations")
}

// -------------------------------------------------------------
// REPORT AUDIT MODEL (Tracks PDF Report Generation)
// -------------------------------------------------------------
model ReportAudit {
  id            String      @id @default(uuid())
  type          ReportType
  title         String
  metadata      String?     // Optional JSON stringified metadata
  createdAt     DateTime    @default(now())

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  generatedById String
  generatedBy   User        @relation(fields: [generatedById], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("report_audits")
}
